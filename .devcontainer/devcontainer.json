{
  "name": "Rumo",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "postCreateCommand": "npm install",
  "forwardPorts": [5173],
  "portsAttributes": { "5173": { "label": "App (npm run dev)", "onAutoForward": "openPreview" } },
  "customizations": {
    "vscode": {
      "extensions": ["vitest.explorer", "dbaeumer.vscode-eslint", "GitHub.copilot", "GitHub.copilot-chat"],
      "settings": { "editor.formatOnSave": true }
    },
    "codespaces": { "openFiles": ["README.md"] }
  }
}
